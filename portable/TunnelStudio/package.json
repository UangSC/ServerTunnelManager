{
  "name": "tunnel-studio-macos",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "macOS 本地 SSH 隧道控制台",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/service.mjs start --enable-ssh",
    "stop": "node bin/service.mjs stop",
    "test": "node --test tests/*.test.mjs",
    "restart": "node bin/service.mjs restart --enable-ssh",
    "status": "node bin/service.mjs status",
    "setup:macos": "node bin/install.mjs"
  }
}
